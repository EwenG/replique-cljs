<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- A ClojureScript compiler and REPL, written against replique-clj's two-world reader and
       namespace registry. See doc/cljs-compiler.md and doc/cljs-repl.md.

       NO JAVA AND NO AOT, which is the whole reason this is a project of its own: everything
       here is Clojure source plus vendored ClojureScript and Closure files, and the three
       pieces of Java it leans on - NamespaceWorld, LispReader's :cljs feature and the
       Compiler's position recording - are in replique-clj, where the vendored Clojure test
       suite is the oracle for them. -->
  <groupId>replique-cljs</groupId>
  <artifactId>clojurescript</artifactId>
  <name>replique-cljs</name>
  <packaging>jar</packaging>
  <version>0.1.0-SNAPSHOT</version>

  <description>A ClojureScript front end for replique-clj: analyzer, emitter, driver and REPL.</description>

  <licenses>
    <license>
      <name>Eclipse Public License 1.0</name>
      <url>http://opensource.org/licenses/eclipse-1.0.php</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Empty by default, so `mvn -o test' runs everything. Set it to run part of
         the suite during an edit: mvn -o test -Dtest.ns=clojure.cljs.compat-test
         (comma-separated for several). DECLARED HERE AND NOT ONLY ON THE COMMAND
         LINE, because -Dtest.ns=${test.ns} in the test execution below is expanded
         by Maven and not by the shell: an undeclared property does not expand to
         the empty string, it stays the literal ${test.ns} and reaches the forked
         JVM as one. src/script/run_cljs_test.clj says why a partial run is a
         middle-of-edit thing and never the last word. -->
    <test.ns></test.ns>
  </properties>

  <dependencies>
    <!-- THE FORK, not org.clojure:clojure. Its artifactId is `clojure` on purpose, so this is a
         substitution rather than an addition - nothing here would work on stock Clojure, which
         has no NamespaceWorld and whose reader has no :cljs feature.

         Built and installed from ../replique-clj with `mvn -o install -DskipTests`. -->
    <dependency>
      <groupId>replique-clj</groupId>
      <artifactId>clojure</artifactId>
      <version>1.12.5-r1</version>
    </dependency>

    <!-- THE ONE LIBRARY DEPENDENCY, and nothing on the JVM side calls it. cljs/reader.cljs is
         vendored beside cljs/core.cljs and opens with (:require [cljs.tools.reader :as treader]
         [cljs.tools.reader.edn :as edn]) - so the seven cljs/tools/reader*.cljs files in this
         jar are SOURCES A COMPILATION READS, the same kind of input as clojure/string.cljs,
         and without them cljs.reader and clojure.edn are shipped and unloadable.

         1.3.6 is what ClojureScript 1.12.145 pins, for the same reason the
         google-closure-library version is the one it pins: our copy of cljs/reader.cljs was
         taken from that release and was written against this reader.

         Clojure is excluded because the fork above stands in for it. Declared in deps.edn too,
         and that is not duplication: a consumer arriving by :local/root reads that file and
         never this one. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>tools.reader</artifactId>
      <version>1.3.6</version>
      <exclusions>
        <exclusion>
          <groupId>org.clojure</groupId>
          <artifactId>clojure</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Only cljs.analyzer is wanted, as an AST oracle; nothing is ever compiled with it.
         ClojureScript's transitive dependencies are therefore excluded wholesale and the two
         the analyzer actually needs are named below: cljs.env reaches for
         com.google.javascript.jscomp.CompilerOptions at load time, and that wants Guava.

         ALSO THE VENDORING ORACLE. src/clj/cljs holds our copies of core.cljc, core.cljs and
         friends; core-test diffs them against this jar, which is why the version is pinned to
         the one they were taken from. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>clojurescript</artifactId>
      <version>1.12.145</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.javascript</groupId>
      <artifactId>closure-compiler-unshaded</artifactId>
      <version>v20240317</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>31.0.1-android</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Not compiled against and not shipped: the goog subset under src/clj/clojure/cljs/goog
         is vendored INTO this repo, and this jar is here so clojure.cljs.goog-test can diff the
         nine vendored files against it byte for byte. The version is the one ClojureScript
         1.12.145 pins, so "unmodified" is checked against the same source cljs.core was written
         for. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>google-closure-library</artifactId>
      <version>0.0-20250515-f04e4c0e</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- The test runner walks test-cljs/ for namespaces. In replique-clj this arrived
         transitively, through test.generative; named here because nothing else brings it. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>tools.namespace</artifactId>
      <version>1.5.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.clojure</groupId>
          <artifactId>clojure</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- clojure.test.check, for the generative properties in calling-convention-test. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>test.check</artifactId>
      <version>1.1.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.clojure</groupId>
          <artifactId>clojure</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <!-- No Java sources. The directory is named so Maven does not invent one. -->
    <sourceDirectory>src/java</sourceDirectory>

    <resources>
      <!-- Everything ships as source: the .clj compiler namespaces, the vendored .cljc/.cljs,
           the goog subset and the three runtime .js files, which clojure.cljs.output reads
           back through io/resource. -->
      <resource>
        <directory>src/clj</directory>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>

      <!-- src/compat into the jar, AND NOT ONE PHASE EARLIER. It holds cljs.analyzer.api
           under ClojureScript's own name, for macro namespaces of somebody else's that
           require it by that name (see deps.edn and doc/cljs-compiler.md 5.66). A
           consumer needs it on the classpath; THIS BUILD MUST NOT HAVE IT, because the
           suite carries ClojureScript 1.12.145 as an AST oracle and a .clj shadows the
           jar's .cljc - analyzer-test's (requiring-resolve 'cljs.analyzer.api/resolve)
           would quietly get ours and compare this compiler with itself.

           So it cannot be a <resource> above: those are copied at process-resources,
           which is before test, and into target/classes, which is ON the test classpath.
           prepare-package runs after test and before jar, which is the one window where
           the file can be added without any test run seeing it. The cost is that
           target/classes differs between `mvn test' and `mvn package'; the benefit is
           that the difference is exactly the file that must not be there during a test.
           clojure.cljs.compat-test asserts the absence, so a mistake here is loud. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>compat-into-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/compat</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Resolves the test-scoped dependency jars into ${cljs-test.deps.classpath} so the
           forked JVM below can be handed an explicit -classpath: the suite needs src/clj and
           test-cljs as DIRECTORIES, ahead of any jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>cljs-test-deps-classpath</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>test</includeScope>
              <outputProperty>cljs-test.deps.classpath</outputProperty>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The suite, on the default `test` phase: it is the only one this project has.
           node on PATH and the ClojureScript jar are each optional - a test that wants one
           and does not find it skips itself (h/deftest-when) - so neither is a build
           dependency. Run with: mvn -o test -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>run-cljs-tests</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <!-- run_cljs_test.clj scans (File. "test-cljs") for namespaces, and
                   test-harness reads src/clj/cljs/core.cljs by relative path. -->
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-classpath</argument>
                <!-- src/clj FIRST, and this is load-bearing twice over: Maven copies it into
                     target/classes, where a stale copy would shadow the sources under test,
                     and the ClojureScript jar further down the path also provides cljs/core.cljc
                     - core-test asserts ours is not the one that wins.

                     target/classes AFTER both source directories, and it is here for the
                     COMPILED JAVA under src/java (clojure.cljs.ws) - there is no other way to
                     reach a .class file. Its copy of the Clojure sources still loses to
                     src/clj, which is the order the paragraph above depends on. -->
                <argument>${project.basedir}/src/clj${path.separator}${project.basedir}/test-cljs${path.separator}${project.build.outputDirectory}${path.separator}${cljs-test.deps.classpath}</argument>
                <argument>-Dtest.ns=${test.ns}</argument>
                <argument>clojure.main</argument>
                <argument>${project.basedir}/src/script/run_cljs_test.clj</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
